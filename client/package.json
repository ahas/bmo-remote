{
  "name": "bmo-remote-client",
  "version": "0.1.0-rev.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "nuxi prepare",
    "api": "openapi-typescript ../docs/openapi.json -o shared/openapi.ts",
    "bundle": "vite build --config module.config.ts",
    "typecheck": "nuxi prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "test": "bun test tests",
    "check": "bun install --frozen-lockfile && bun run typecheck && bun run test && bun run bundle",
    "ironrdp": "bun scripts/build-ironrdp.ts"
  },
  "dependencies": {
    "@devolutions/iron-remote-desktop": "0.11.0",
    "@devolutions/iron-remote-desktop-rdp": "file:./vendor/iron-remote-desktop-rdp",
    "@nuxt/ui": "^4.11.2",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "get-east-asian-width": "^1.7.0",
    "vue": "^3.5.24",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.4",
    "@vitejs/plugin-vue": "6.0.10",
    "bmo-ui": "file:vendor/bmo-ui-0.1.0-rev.24.tgz",
    "nuxt": "^4.5.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vue-i18n": "^11.4.8",
    "vue-tsc": "^3.2.0"
  }
}
