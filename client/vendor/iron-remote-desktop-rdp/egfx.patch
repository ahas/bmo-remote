+                destination_rectangle: ExclusiveRectangle {
+                    left: 0,
+                    top: 0,
+                    right: 16,
+                    bottom: 16,
+                },
+                bitmap_data,
+            }),
+            GfxPdu::EndFrame(crate::pdu::EndFramePdu { frame_id: 1 }),
