index 00000000..fdef5b8a
--- /dev/null
+++ b/crates/ironrdp-web/src/avc420.rs
@@ -0,0 +1,217 @@
+//! AVC420 pictures of the graphics pipeline, decoded by the browser.
+//!
+//! The graphics pipeline hands each AVC420 command out (see
+//! `GraphicsPipelineClient::with_external_avc420`); this module passes its H.264
+//! bitstream to the WebCodecs decoder in `avc420.js` and brings back the RGBA
+//! pixels of the regions the command updates.
+
+use ironrdp_egfx::client::ExternalAvc420;
+use ironrdp_egfx::pdu::{annex_b_to_avc, avc_to_annex_b_into};
+use ironrdp_pdu::geometry::ExclusiveRectangle;
+use js_sys::{Promise, Uint8Array};
+use wasm_bindgen::prelude::*;
+use wasm_bindgen_futures::JsFuture;
+
+#[wasm_bindgen(module = "/src/avc420.js")]
+extern "C" {
+    #[wasm_bindgen(js_name = avc420Supported)]
+    fn avc420_supported(width: u16, height: u16) -> Promise;
+
+    type Avc420Decoder;
+
+    #[wasm_bindgen(constructor)]
+    fn new() -> Avc420Decoder;
+
+    #[wasm_bindgen(method)]
+    fn decode(
+        this: &Avc420Decoder,
+        surface_id: u16,
+        bitstream: &[u8],
+        key: bool,
+        codec: Option<String>,
+        regions: &[u16],
+    ) -> Promise;
+
+    #[wasm_bindgen(method)]
+    fn close(this: &Avc420Decoder);
+}
+
+const NAL_TYPE_IDR: u8 = 5;
+const NAL_TYPE_SPS: u8 = 7;
+
+/// Whether this browser decodes H.264 at the given desktop size, so AVC420 may be offered.
+pub(crate) async fn supported(width: u16, height: u16) -> bool {
+    JsFuture::from(avc420_supported(width, height))
+        .await
+        .ok()
+        .and_then(|supported| supported.as_bool())
+        .unwrap_or(false)
+}
+
+/// The browser's H.264 decoders of one session, one stream per surface.
+pub(crate) struct Avc420Bridge {
+    decoder: Avc420Decoder,
+}
+
+impl Avc420Bridge {
+    pub(crate) fn new() -> Self {
+        Self {
+            decoder: Avc420Decoder::new(),
+        }
+    }
+
+    /// Decodes the command's picture and returns each region it updates, with its RGBA pixels.
+    pub(crate) async fn decode(&self, command: &ExternalAvc420) -> anyhow::Result<Vec<(ExclusiveRectangle, Vec<u8>)>> {
+        let picture = Picture::read(&command.bitstream);
+        let regions: Vec<ExclusiveRectangle> = command
+            .regions
+            .iter()
+            .map(|region| even_aligned(region, command.surface_width, command.surface_height))
+            .collect();
+        let picture_regions: Vec<u16> = regions
+            .iter()
+            .flat_map(|region| {
+                [
+                    region.left,
+                    region.top,
+                    region.right - region.left,
+                    region.bottom - region.top,
+                ]
+            })
+            .collect();
+
+        let pixels = JsFuture::from(self.decoder.decode(
+            command.surface_id,
+            &picture.annex_b,
+            picture.key,
+            picture.codec,
+            &picture_regions,
+        ))
+        .await
+        .map_err(|error| anyhow::anyhow!("H.264 decode failed: {error:?}"))?;
+        let pixels = Uint8Array::new(&pixels).to_vec();
+
+        let mut offset = 0;
+        let mut decoded = Vec::with_capacity(regions.len());
+        for region in regions {
+            let size = usize::from(region.right - region.left) * usize::from(region.bottom - region.top) * 4;
+            let data = pixels
+                .get(offset..offset + size)
+                .ok_or_else(|| anyhow::anyhow!("H.264 decoder returned too few pixels"))?
+                .to_vec();
+            offset += size;
+            decoded.push((region, data));
+        }
+        Ok(decoded)
+    }
+}
+
+impl Drop for Avc420Bridge {
+    fn drop(&mut self) {
+        self.decoder.close();
+    }
+}
+
+/// The parts of an AVC420 bitstream WebCodecs needs.
+struct Picture {
+    /// The NAL units with start codes, the form WebCodecs reads without a configuration record.
+    annex_b: Vec<u8>,
+    /// Whether it holds an IDR picture, which a decoder can start from.
+    key: bool,
+    /// The `avc1` codec string its sequence parameter set names, when it carries one.
+    codec: Option<String>,
+}
+
+impl Picture {
+    /// Servers send the NAL units with start codes or with four-byte length prefixes; both are read.
+    fn read(bitstream: &[u8]) -> Self {
+        let has_start_code = bitstream.starts_with(&[0, 0, 1]) || bitstream.starts_with(&[0, 0, 0, 1]);
+        let length_prefixed = if has_start_code {
+            annex_b_to_avc(bitstream)
+        } else {
+            bitstream.to_vec()
+        };
+
+        let mut key = false;
+        let mut codec = None;
+        let mut rest = length_prefixed.as_slice();
+        while let Some((length, after)) = rest.split_first_chunk::<4>() {
+            let length = usize::try_from(u32::from_be_bytes(*length)).unwrap_or(usize::MAX);
+            let Some(unit) = after.get(..length) else {
+                break;
+            };
+            match unit.first().map(|header| header & 0x1F) {
+                Some(NAL_TYPE_IDR) => key = true,
+                Some(NAL_TYPE_SPS) if unit.len() >= 4 => {
+                    codec = Some(format!("avc1.{:02x}{:02x}{:02x}", unit[1], unit[2], unit[3]));
+                }
+                _ => {}
+            }
+            rest = &after[length..];
+        }
+
+        let mut annex_b = Vec::with_capacity(length_prefixed.len());
+        avc_to_annex_b_into(&length_prefixed, &mut annex_b);
+        Self { annex_b, key, codec }
+    }
+}
+
+/// Widens a region to even coordinates inside the picture: a 4:2:0 picture is read out in
+/// whole chroma samples.
+fn even_aligned(region: &ExclusiveRectangle, width: u16, height: u16) -> ExclusiveRectangle {
+    ExclusiveRectangle {
+        left: region.left & !1,
+        top: region.top & !1,
+        right: (region.right.saturating_add(1) & !1).min(width),
+        bottom: (region.bottom.saturating_add(1) & !1).min(height),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn rectangle(left: u16, top: u16, right: u16, bottom: u16) -> ExclusiveRectangle {
+        ExclusiveRectangle {
+            left,
+            top,
+            right,
+            bottom,
+        }
+    }
+
+    const SPS: [u8; 5] = [0x67, 0x64, 0x00, 0x33, 0xAC];
+    const IDR: [u8; 3] = [0x65, 0x88, 0x84];
+    const P_SLICE: [u8; 3] = [0x41, 0x9A, 0x02];
+
+    #[test]
+    fn reads_a_key_picture_with_start_codes() {
+        let bitstream = [&[0, 0, 0, 1][..], &SPS, &[0, 0, 1], &IDR].concat();
+
+        let picture = Picture::read(&bitstream);
+
+        assert!(picture.key);
+        assert_eq!(picture.codec.as_deref(), Some("avc1.640033"));
+        assert_eq!(picture.annex_b, [&[0, 0, 0, 1][..], &SPS, &[0, 0, 0, 1], &IDR].concat());
+    }
+
+    #[test]
+    fn reads_a_length_prefixed_delta_picture() {
+        let bitstream = [&[0, 0, 0, 3][..], &P_SLICE].concat();
+
+        let picture = Picture::read(&bitstream);
+
+        assert!(!picture.key);
+        assert_eq!(picture.codec, None);
+        assert_eq!(picture.annex_b, [&[0, 0, 0, 1][..], &P_SLICE].concat());
+    }
+
+    #[test]
+    fn widens_regions_to_even_coordinates_inside_the_picture() {
+        assert_eq!(even_aligned(&rectangle(3, 5, 9, 10), 100, 51), rectangle(2, 4, 10, 10));
+        assert_eq!(
+            even_aligned(&rectangle(98, 49, 100, 51), 100, 51),
+            rectangle(98, 48, 100, 51)
+        );
+    }
+}
