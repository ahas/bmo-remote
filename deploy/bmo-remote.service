# The remote service's user unit. A deployment runs it from its deploy tree, whose settings.local.toml links
# to the data root's env/remote.toml (docs/api.md, 「Settings」). The tmux server the terminal sessions stand
# on is a transient unit of its own, so stopping this one keeps every session (docs/remote.md, 「The server
# outlives the service」). The desktop sidecar is its child and goes with it.
[Unit]
Description=bmo-remote: the console's terminal sessions and remote desktop
After=network-online.target
# Without its settings the service has no token or desktop password, so the unit does not start where the
# deployment wrote none.
ConditionPathExists=%h/.local/share/bmo/data/env/remote.toml

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-remote/deploy
# The desktop sidecar the service starts beside itself is run by the account's bun, which a user unit's PATH
# does not hold (docs/api.md, 「The desktop sidecar」).
Environment=BMO_REMOTE_SIDECAR__BUN=%h/.bun/bin/bun
ExecStart=%h/.local/share/bmo-remote/deploy/bin/bmo-remote serve
Restart=always
RestartSec=2
TimeoutStopSec=30

[Install]
WantedBy=default.target
# The repository's one service: stopped, restarted and watched by every deployment, which waits on its health.
X-BMO-Deploy=bot
