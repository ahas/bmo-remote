{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/WireError"
            }
          }
        },
        "description": "A refusal, in the common error shape."
      }
    },
    "schemas": {
      "Account": {
        "description": "The account the service runs as, and whether the desktop's password is kept.",
        "properties": {
          "keptPassword": {
            "description": "Whether `desktop.password` is set and not empty.",
            "type": "boolean"
          },
          "name": {
            "description": "The account's name, which the terminal and the desktop are reached as.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "keptPassword"
        ],
        "type": "object"
      },
      "Health": {
        "description": "Whether the service is ready, why not where it is not, and its version.",
        "properties": {
          "ready": {
            "description": "The store is open and the service answers.",
            "type": "boolean"
          },
          "reason": {
            "description": "Why it is not ready; null while it is.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ready",
          "reason",
          "version"
        ],
        "type": "object"
      },
      "Terminal": {
        "description": "One terminal session of the service's tmux server.",
        "properties": {
          "createdAt": {
            "description": "When it began, in epoch milliseconds.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The session's id: `t-` and lower-case letters and digits.",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/TerminalState"
          },
          "title": {
            "description": "What a person names it, empty where it has no name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "state",
          "createdAt"
        ],
        "type": "object"
      },
      "TerminalPage": {
        "description": "A page of terminal sessions, in the order they began.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Terminal"
            },
            "type": "array"
          },
          "more": {
            "description": "Whether anything stands past the last item.",
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "more"
        ],
        "type": "object"
      },
      "TerminalRename": {
        "description": "The body of `PATCH /terminals/{terminalId}`: the name the session takes, an empty one taking it away.",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "TerminalRequest": {
        "description": "The body of `POST /terminals`: the name the new session takes, where one is given.",
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "TerminalState": {
        "description": "Where a terminal session stands in its life. The list holds the sessions that stand, so every member it\nanswers is `running`; an ended session is gone from the list.",
        "enum": [
          "running"
        ],
        "type": "string"
      },
      "WireError": {
        "description": "A failure, in the common error shape: the kebab-case code a caller matches on, and the English sentence\nfor a log.",
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "The token of the service's settings.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The console's remote access: terminal sessions on this machine (tmux) and the desktop through RDP, relayed to a browser screen. A downstream that calls nothing. The paths carry no prefix; the console relays them under its own base behind its sign-in.",
    "title": "bmo-remote",
    "version": "0.1.0-rev.2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/account": {
      "get": {
        "operationId": "readAccount",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "The desktop account and whether its password is kept."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "The desktop account and whether its password is kept.",
        "tags": [
          "account"
        ],
        "x-codes": [
          "unauthorized"
        ]
      }
    },
    "/desktop/keys": {
      "get": {
        "operationId": "readDesktopKeys",
        "responses": {
          "101": {
            "description": "The desktop's keyboard messages: a WebSocket."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "The desktop's keyboard messages: a WebSocket.",
        "tags": [
          "desktop"
        ],
        "x-codes": [
          "unauthorized"
        ]
      }
    },
    "/desktop/pointer": {
      "get": {
        "operationId": "readDesktopPointer",
        "responses": {
          "101": {
            "description": "The desktop's pointer messages: a WebSocket."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "The desktop's pointer messages: a WebSocket.",
        "tags": [
          "desktop"
        ],
        "x-codes": [
          "unauthorized"
        ]
      }
    },
    "/desktop/socket": {
      "get": {
        "operationId": "relayDesktop",
        "responses": {
          "101": {
            "description": "The desktop's RDP relay: a WebSocket."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "The desktop's RDP relay: a WebSocket.",
        "tags": [
          "desktop"
        ],
        "x-codes": [
          "unauthorized"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "readHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Readiness and version."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Readiness and version.",
        "tags": [
          "health"
        ],
        "x-codes": [
          "unauthorized"
        ]
      }
    },
    "/terminals": {
      "get": {
        "operationId": "listTerminals",
        "parameters": [
          {
            "description": "How many sessions were already read.",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "description": "How many sessions were already read.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "How many to read, 100 where none is given and at most 1000.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "How many to read, 100 where none is given and at most 1000.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalPage"
                }
              }
            },
            "description": "The terminal sessions, in the order they began."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "The terminal sessions, in the order they began.",
        "tags": [
          "terminals"
        ],
        "x-codes": [
          "unauthorized",
          "bad-request",
          "failed"
        ]
      },
      "post": {
        "operationId": "createTerminal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Terminal"
                }
              }
            },
            "description": "Open a terminal session: the account's login shell."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Open a terminal session: the account's login shell.",
        "tags": [
          "terminals"
        ],
        "x-codes": [
          "unauthorized",
          "bad-request",
          "failed"
        ]
      }
    },
    "/terminals/{terminalId}": {
      "delete": {
        "operationId": "endTerminal",
        "parameters": [
          {
            "description": "The session's id: `t-` and lower-case letters and digits.",
            "in": "path",
            "name": "terminalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "End a terminal session and every program in it."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "End a terminal session and every program in it.",
        "tags": [
          "terminals"
        ],
        "x-codes": [
          "unauthorized",
          "not-found",
          "failed"
        ]
      },
      "get": {
        "operationId": "readTerminal",
        "parameters": [
          {
            "description": "The session's id: `t-` and lower-case letters and digits.",
            "in": "path",
            "name": "terminalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Terminal"
                }
              }
            },
            "description": "One terminal session."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "One terminal session.",
        "tags": [
          "terminals"
        ],
        "x-codes": [
          "unauthorized",
          "not-found",
          "failed"
        ]
      },
      "patch": {
        "operationId": "renameTerminal",
        "parameters": [
          {
            "description": "The session's id: `t-` and lower-case letters and digits.",
            "in": "path",
            "name": "terminalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalRename"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Terminal"
                }
              }
            },
            "description": "Rename a terminal session; an empty title takes the name away."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Rename a terminal session; an empty title takes the name away.",
        "tags": [
          "terminals"
        ],
        "x-codes": [
          "unauthorized",
          "bad-request",
          "not-found",
          "failed"
        ]
      }
    },
    "/terminals/{terminalId}/socket": {
      "get": {
        "operationId": "attachTerminal",
        "parameters": [
          {
            "description": "The session's id: `t-` and lower-case letters and digits.",
            "in": "path",
            "name": "terminalId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Attach to a terminal: a WebSocket, both sides speaking."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Attach to a terminal: a WebSocket, both sides speaking.",
        "tags": [
          "terminals"
        ],
        "x-codes": [
          "unauthorized",
          "not-found",
          "failed"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "servers": [
    {
      "description": "the remote service",
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "account"
    },
    {
      "name": "terminals"
    },
    {
      "name": "desktop"
    }
  ],
  "x-calls": [],
  "x-layer": "downstream",
  "x-stage": 5,
  "x-tools": []
}
