{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/WireError"
            }
          }
        },
        "description": "A refusal, in the common error shape."
      }
    },
    "schemas": {
      "Account": {
        "description": "The account the service runs as, and whether the desktop's password is kept.",
        "properties": {
          "keptPassword": {
            "description": "Whether `desktop.password` is set and not empty.",
            "type": "boolean"
          },
          "name": {
            "description": "The account's name, which the terminal and the desktop are reached as.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "keptPassword"
        ],
        "type": "object"
      },
      "ConsoleManifest": {
        "description": "The console manifest (bmo-ui's `docs/console-bundles.md`, 「The manifest」): what a console attaches the\nremote screen by.",
        "properties": {
          "apiPrefix": {
            "description": "The path every call the screens make stands under.",
            "type": "string"
          },
          "bundle": {
            "description": "The path the module is answered at.",
            "type": "string"
          },
          "events": {
            "description": "Whether the screens read the service's event stream.",
            "type": "boolean"
          },
          "icon": {
            "description": "The icon drawn beside that name.",
            "type": "string"
          },
          "name": {
            "description": "The bundle's name, its words' namespace.",
            "type": "string"
          },
          "ownerKey": {
            "description": "Whether every call the screens make needs the reader's owner key.",
            "type": "boolean"
          },
          "pushKinds": {
            "description": "The event kinds a console may raise as a notice to a reader not on the screen.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/ConsoleRole",
            "description": "The least role a reader holds to open the screen."
          },
          "screenPath": {
            "description": "The path the screens stand under.",
            "type": "string"
          },
          "serviceName": {
            "description": "The name a console relays the service under.",
            "type": "string"
          },
          "stylesheet": {
            "description": "The path the stylesheet is answered at.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "The key, in the bundle's words, of the name a console's menu gives the screen.",
            "type": "string"
          },
          "websocket": {
            "description": "Whether the screens open a WebSocket to the service.",
            "type": "boolean"
          },
          "words": {
            "description": "The path the words are answered at.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "title",
          "icon",
          "screenPath",
          "serviceName",
          "bundle",
          "words",
          "apiPrefix",
          "role",
          "ownerKey",
          "events",
          "websocket",
          "pushKinds"
        ],
        "type": "object"
      },
      "ConsoleRole": {
        "description": "A role a reader holds, the one holding more first: an administrator holds every role a member holds.",
        "enum": [
          "administrator",
          "member"
        ],
        "type": "string"
      },
      "Health": {
        "description": "Whether the service is ready, why not where it is not, and its version.",
        "properties": {
          "ready": {
            "description": "The store is open and the service answers.",
            "type": "boolean"
          },
          "reason": {
            "description": "Why it is not ready; null while it is.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ready",
          "reason",
          "version"
        ],
        "type": "object"
      },
      "Terminal": {
        "description": "One terminal session of the service's tmux server.",
        "properties": {
          "createdAt": {
            "description": "When it began, in epoch milliseconds.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The session's id: `t-` and lower-case letters and digits.",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/TerminalState"
          },
          "title": {
            "description": "What a person names it, empty where it has no name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "state",
          "createdAt"
        ],
        "type": "object"
      },
      "TerminalPage": {
        "description": "A page of terminal sessions, in the order they began.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Terminal"
            },
            "type": "array"
          },
          "more": {
            "description": "Whether anything stands past the last item.",
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "more"
        ],
        "type": "object"
      },
      "TerminalRename": {
        "description": "The body of `PATCH /terminals/{terminalId}`: the name the session takes, an empty one taking it away.",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "TerminalRequest": {
        "description": "The body of `POST /terminals`: the name the new session takes, where one is given.",
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "TerminalState": {
        "description": "Where a terminal session stands in its life. The list holds the sessions that stand, so every member it\nanswers is `running`; an ended session is gone from the list.",
        "enum": [
          "running"
        ],
        "type": "string"
      },
      "WireError": {
        "description": "A failure, in the common error shape: the kebab-case code a caller matches on, and the English sentence\nfor a log.",
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "The token of the service's settings.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The console's remote access: terminal sessions on this machine (tmux) and the desktop through RDP, relayed to a browser screen. A downstream that calls nothing. The paths carry no prefix; the console relays them under its own base behind its sign-in.",
    "title": "bmo-remote",
    "version": "0.1.0-rev.4"
  },
  "openapi": "3.1.0",
  "paths": {
    "/account": {
      "get": {
        "operationId": "readAccount",
        "parameters": [
          {
            "description": "The reader's role, which must allow the screen's administrator.",
            "in": "header",
            "name": "Owner-Role",
            "required": true,
            "schema": {
              "enum": [
                "administrator",
                "member"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "The desktop account and whether its password is kept."
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "The desktop account and whether its password is kept.",
        "tags": [
          "account"
        ],
        "x-codes": [
          "unauthorized",
          "forbidden"
        ]
      }
    },
